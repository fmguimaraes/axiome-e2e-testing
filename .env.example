# Environment targeting for the E2E suite (AXI-1261 / AXI-1262).
# Copy to `.env` and override to retarget the suite. Defaults are the local
# `make local-up` stack, so an unset .env runs against localhost with no edits.
# NEVER put a secret in a committed file (NFR6) — role credentials are supplied
# at run time by env vars or the platform secret store (AXI-1264).

# Front-end origin the browser drives.
BASE_URL=http://localhost:5173

# Backend API origin (setup/teardown, API-only specs).
API_BASE_URL=http://localhost:3000

# Public, browser-reachable object-storage endpoint (MinIO/S3). Not the
# service-internal endpoint (FR8).
OBJECT_PUBLIC_URL=http://localhost:9000

# --- Staging toolkit (AXI-1369, staging/**) ---------------------------------
# Gateway origin the staging toolkit drives — MUST be allow-listed (NFR2/EC10).
# Defaults (localhost:3000/127.0.0.1:3000) are baked in; only set this to
# retarget within the allow-list.
STAGING_BASE_URL=http://localhost:3000

# Comma-separated ADDITIONAL base URLs to allow-list, beyond the localhost
# defaults. Never add a production-looking origin (the guard hard-refuses
# anything containing "axiomebio.com" regardless of this list).
STAGING_ALLOWED_BASE_URLS=

# Bootstrap admin used ONLY to create the service account (FR2) — never
# committed for real here; local default matches the seeded local stack.
STAGING_ADMIN_EMAIL=admin@axiome.local
STAGING_ADMIN_PASSWORD=admin

# Path to the gateway's controller source, for the route-table extractor
# (FR15). Only needed when this checkout is not a standard sibling of
# axiome-back (e.g. running from a worktree) — the audit reports a clear
# error and its resolved default if this is unset and wrong.
GATEWAY_SRC_PATH=
